# Production: `wrangler secret put CREDENTIAL_ENCRYPTION_KEY`. Local: ignored .dev.vars.
# Base64-encoded 32 cryptographically random bytes; never use this placeholder.
CREDENTIAL_ENCRYPTION_KEY=...
# Local only. Stands in for a Cloudflare Access sign-in on localhost.
DEV_USER_EMAIL=you@example.com

# New app sign-in. Use a separate random secret of at least 32 characters.
# Production values belong in Worker secrets; never commit actual values.
BETTER_AUTH_SECRET=...
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth web client: /api/auth/callback/google on BETTER_AUTH_URL.
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
# Optional shared AI. When set, all web users use this server-side key.
GROQ_API_KEY=...
# Alternative: reuse an existing encrypted server credential, without exporting it.
SHARED_GROQ_CREDENTIAL_OWNER=...
SHARED_AI_DAILY_LIMIT=50
SHARED_AI_GLOBAL_DAILY_LIMIT=1000
