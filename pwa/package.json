{
  "name": "catchall-desk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "publish:mac-download": "node --import tsx scripts/publish-mac-download.ts",
    "publish:windows-downloads": "node --import tsx scripts/publish-windows-downloads.ts",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app lib components/do db tests",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:built-downloads": "node scripts/verify-built-downloads.mjs",
    "test:built-clipboard": "node --import tsx scripts/verify-built-clipboard.mjs",
    "test:built-auth": "node --import tsx scripts/verify-built-auth.mjs",
    "test:built-content": "node --import tsx scripts/verify-built-content.mjs",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply DB --local",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "types": "wrangler types db/bindings.d.ts --include-runtime false",
    "predev": "node scripts/prepare-pdf-assets.mjs",
    "prebuild": "node scripts/prepare-pdf-assets.mjs",
    "test:built-shared-items": "node --import tsx scripts/verify-built-shared-items.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@better-auth/core": "1.7.4",
    "@better-auth/drizzle-adapter": "1.7.4",
    "@better-auth/oauth-provider": "1.7.4",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "1.3.1",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "better-auth": "1.7.4",
    "better-call": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "input-otp": "1.4.2",
    "jose": "6.2.12",
    "lucide-react": "1.31.0",
    "pdfjs-dist": "6.5.438",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "fake-indexeddb": "6.2.4",
    "miniflare": "4.20260515.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
